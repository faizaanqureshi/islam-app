{
  "name": "islam-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:capacitor": "mv src/app/api .api.bak && (NEXT_PUBLIC_API_BASE=https://islam-app.vercel.app CAPACITOR_BUILD=true next build; EXIT=$?; mv .api.bak src/app/api; exit $EXIT)",
    "build:ios": "pnpm build:capacitor && npx cap sync ios",
    "build:android": "pnpm build:capacitor && npx cap sync android",
    "ingest:quran": "tsx scripts/ingest-quran.ts",
    "ingest:quran:english": "tsx scripts/ingest-quran-english.ts",
    "ingest:all": "pnpm ingest:quran && pnpm ingest:quran:english",
    "process-tafsir": "tsx scripts/process-tafsir.ts",
    "fetch:page-numbers": "tsx scripts/fetch-page-numbers.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.2.0",
    "@capacitor/geolocation": "^8.1.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@supabase/supabase-js": "^2.91.0",
    "next": "16.1.4",
    "openai": "^4.77.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
